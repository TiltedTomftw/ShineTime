{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "expo-tunnel",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--tunnel", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "dashboard", "-l", "8082"],
      "port": 8082
    }
  ]
}
