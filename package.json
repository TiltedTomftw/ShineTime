{
  "name": "shinetime-detail-tracker",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 __tests__/integration/app.integration.js __tests__/integration/dashboard.integration.js",
    "test:components": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.6.3",
    "@supabase/supabase-js": "^2.102.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.36",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/components/**/*.spec.js"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  }
}
